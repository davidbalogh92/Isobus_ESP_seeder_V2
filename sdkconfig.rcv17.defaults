# ESP32S3 RCv1.7 panel (ESP32-S3-WROOM-1U-N16): 16 MB flash, NINCS PSRAM.
# A sdkconfig.defaults után töltődik (platformio.ini: SDKCONFIG_DEFAULTS), az ottani PSRAM-beállítást írja felül.
# CONFIG_SPIRAM is not set
# A GPIO35/36/37 a W5500-é (oktális PSRAM nélküli modul). A flash VDD_SPI eFuse-zal 3,3 V-ra égetve.

# --- belső RAM spórolás (nincs PSRAM; WiFi szerviz módban a webnek is kell hely)
# A WiFi / lwIP gyorsító kódja ne az IRAM-ban legyen (az S3-on az IRAM és a DRAM ugyanaz a memória)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# kevesebb WiFi puffer (szerviz mód: 1–3 telefon, kis forgalom)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# kisebb adatgyorsítótár (16 kB a 32 helyett): +16 kB belső RAM
CONFIG_ESP32S3_DATA_CACHE_16KB=y
